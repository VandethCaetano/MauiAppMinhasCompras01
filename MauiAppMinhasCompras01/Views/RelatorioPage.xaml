<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras01.Views.RelatorioPage"
             Title="Relatório por Categoria">

    <CollectionView x:Name="collectionRelatorio">
        
        <CollectionView.ItemTemplate>
            
            <DataTemplate>
                <StackLayout Padding="10">
                    
                    <Label Text="{Binding Categoria}" FontAttributes="Bold" FontSize="16" />
                    
                    <Label Text="{Binding Total, StringFormat='Total: {0:C}'}" FontSize="14" />
                
                </StackLayout>
            </DataTemplate>
        
        
        </CollectionView.ItemTemplate>
    
    </CollectionView>

</ContentPage>
