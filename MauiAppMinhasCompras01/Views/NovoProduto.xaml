<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras01.Views.NovoProduto"
             Title="NovoProduto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked"/>
        
    </ContentPage.ToolbarItems>
    
    <VerticalStackLayout Spacing="10" Padding="10">
        <Label 
            Text="Descrição Produto" FontAttributes="Bold" FontSize="14" />
        <Entry x:Name="txt_descricao"/>
        <Label
            Text="Quantidade" FontAttributes="Bold" FontSize="14" />
        <Entry x:Name="txt_quantidade" Keyboard="Numeric"/>

        <Label 
        Text="Categoria" FontAttributes="Bold" FontSize="14" />
        <Entry x:Name="txt_categoria"/>

        <Label
            Text="Preço unitário" FontAttributes="Bold" FontSize="14" />
        <Entry x:Name="txt_preco" Keyboard="Numeric"/>

    </VerticalStackLayout>
</ContentPage>