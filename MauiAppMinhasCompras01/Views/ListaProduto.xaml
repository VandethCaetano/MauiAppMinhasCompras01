<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras01.Views.ListaProduto"
             Title="Minhas Compras">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Somar" Clicked="ToolbarItem_Clicked_1"/>
        <ToolbarItem Text="Adicionar" Clicked="ToolbarItem_Clicked"/>
        <ToolbarItem Text="Relatório" Clicked="AbrirRelatorio_Clicked"/>
    </ContentPage.ToolbarItems>

    <ContentView Padding="20">
  
        <VerticalStackLayout>

            <SearchBar x:Name="txt_search" 
                       Placeholder="Busca de Produtos"
                       TextChanged="txt_search_TextChanged" />

            <Picker x:Name="picker_categoria"
            Title="Filtrar por categoria"
            SelectedIndexChanged="picker_categoria_SelectedIndexChanged" />

            <ListView x:Name="lst_produtos" ItemSelected="lst_produtos_ItemSelected">

                <ListView.Header>
                    <Grid ColumnDefinitions="*, *, *, *, *, *" >
                        <Label Grid.Column="0" Text="ID" FontSize="14" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Text="Descrição" FontSize="14" FontAttributes="Bold"/>
                        <Label Grid.Column="2" Text="Preço" FontSize="14" FontAttributes="Bold"/>
                        <Label Grid.Column="3" Text="Qnt" FontSize="14" FontAttributes="Bold"/>
                        <Label Grid.Column="4" Text="Categoria" FontSize="14" FontAttributes="Bold"/>
                        <Label Grid.Column="5" Text="Total" FontSize="14" FontAttributes="Bold"/>

                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.ContextActions>
                                <MenuItem Text="Remover" Clicked="MenuItem_Clicked"/>
                            </ViewCell.ContextActions>

                            <Grid ColumnDefinitions="*, *, *, *, *, *">
                                <Label Grid.Column="0" Text="{Binding Id}"/>
                                <Label Grid.Column="1" Text="{Binding Descricao}"/>
                                <Label Grid.Column="2" Text="{Binding Preco}"/>
                                <Label Grid.Column="3" Text="{Binding Quantidade}"/>
                                <Label Grid.Column="4" Text="{Binding Categoria}"/>
                                <Label Grid.Column="5" Text="{Binding Total}"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>                              

            </ListView>

        </VerticalStackLayout>

    </ContentView>

</ContentPage>
